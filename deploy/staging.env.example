# =============================================================================
# deploy/staging.env.example — Staging environment variables
#
# Copy this file and fill in real values before creating the Kubernetes Secret:
#
#   cp deploy/staging.env.example /tmp/staging.env
#   # edit /tmp/staging.env
#   kubectl create secret generic sw3-secrets \
#     --namespace sw3 \
#     --from-env-file=/tmp/staging.env \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# NEVER commit a populated version of this file.
# All defaults here are placeholders that MUST be replaced.
# =============================================================================

# ── Auth ──────────────────────────────────────────────────────────────────────
# Minimum 32-byte random string. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# ── Database — PostgreSQL ─────────────────────────────────────────────────────
# Connection string for the staging PostgreSQL instance (RDS, Cloud SQL, etc.)
DATABASE_URL=postgresql://sw3:<PASSWORD>@<HOST>:5432/sw3_staging

# ── Cache — Redis ─────────────────────────────────────────────────────────────
# Connection string for the staging Redis instance (ElastiCache, Upstash, etc.)
REDIS_URL=redis://:<PASSWORD>@<HOST>:6379/0

# ── Analytics — ClickHouse ────────────────────────────────────────────────────
CLICKHOUSE_HOST=<HOST>
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=REPLACE_WITH_CLICKHOUSE_PASSWORD
CLICKHOUSE_DATABASE=sw3_analytics

# ── Blockchain — RPC endpoint ─────────────────────────────────────────────────
# Point to a staging network (Sepolia, Holesky, or a private testnet)
RPC_URLS=https://sepolia.infura.io/v3/<INFURA_KEY>
CHAIN_ID=11155111

# ── Sweeper / Execution ───────────────────────────────────────────────────────
# Private key of the staging relayer wallet. Fund with testnet ETH before use.
SWEEPER_PRIVATE_KEY=0x<STAGING_RELAYER_PRIVATE_KEY>
SWEEPER_CONTRACT=0x<DEPLOYED_SWEEPER_ADDRESS>
DELEGATED_EXECUTOR_ADDRESS=0x<DEPLOYED_DELEGATED_EXECUTOR_ADDRESS>

# ── API Gateway ───────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_GATEWAY_SECRET_KEY
CORS_ORIGINS=https://app.sw3.example.com

# ── Dashboard (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.sw3.example.com/v1
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_CHAIN_NAME=Sepolia
NEXT_PUBLIC_RPC_URL=https://sepolia.infura.io/v3/<INFURA_KEY>
NEXTAUTH_SECRET=REPLACE_WITH_NEXTAUTH_SECRET
NEXTAUTH_URL=https://app.sw3.example.com

# ── Misc ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=staging
LOG_LEVEL=info
