# =============================================================================
# .env.local.example — Local Development Environment Variables
#
# Copy to .env.local for docker-compose local dev:
#   cp .env.local.example .env.local
#
# All values here are safe defaults for local development only.
# NEVER use these values in staging or production.
# =============================================================================

# ─── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
ENVIRONMENT=development

# ─── Auth Service (port 8001) ─────────────────────────────────────────────────
JWT_SECRET=local-dev-jwt-secret-change-in-production-use-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
NONCE_TTL_SECONDS=300

# ─── API Gateway (port 8000) ──────────────────────────────────────────────────
SECRET_KEY=local-dev-gateway-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_SERVICE_URL=http://auth-service:8001
EXECUTION_ENGINE_URL=http://execution-engine:8080
SIMULATION_ENGINE_URL=http://simulation-engine:8082
ANALYTICS_SERVICE_URL=http://analytics-service:8004
BILLING_SERVICE_URL=http://billing-service:8005
WEBHOOK_SERVICE_URL=http://webhook-service:8006

# ─── Database — PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=sw3
POSTGRES_PASSWORD=sw3dev
POSTGRES_DB=sw3_dev
DATABASE_URL=postgresql://sw3:sw3dev@postgres:5432/sw3_dev
DATABASE_URL_LOCAL=postgresql://sw3:sw3dev@localhost:5432/sw3_dev

# ─── Cache — Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# ─── Analytics — ClickHouse ───────────────────────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=sw3_analytics

# ─── Blockchain — Anvil local chain ───────────────────────────────────────────
# Anvil is started with a fixed mnemonic so wallet addresses are reproducible.
# Default funded accounts (from mnemonic "test test test test test test test test test test test junk"):
#   Account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 (10000 ETH)
#   Account #1: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8 (10000 ETH)
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_CHAIN_NAME=AnvilLocal
NEXT_PUBLIC_RPC_URL=http://localhost:8545
RPC_URL=http://anvil:8545
RPC_URL_LOCAL=http://localhost:8545
CHAIN_ID=31337

# Anvil default test private key (Account #0 — local only, NEVER use in prod)
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RELAYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
SWEEPER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Contract addresses — populated by scripts/deploy-contracts.sh after first run
NEXT_PUBLIC_CONTRACT_ADDRESS=
SWEEPER_CONTRACT_ADDRESS=
NEXT_PUBLIC_SWEEPER_ADDRESS=
DELEGATED_EXECUTOR_ADDRESS=
NEXT_PUBLIC_DELEGATED_EXECUTOR_ADDRESS=
PERMIT_ROUTER_ADDRESS=
FEE_ROUTER_ADDRESS=
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
MULTICALL_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# ─── Execution Engine ─────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
MAX_BATCH_SIZE=50
GAS_MULTIPLIER=1.2
CONFIRMATION_BLOCKS=1

# ─── Dashboard (Next.js, port 3000) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXTAUTH_SECRET=local-dev-nextauth-secret-change-in-prod
NEXTAUTH_URL=http://localhost:3000

# ─── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=sw3-local
OTEL_SERVICE_VERSION=0.0.1

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=true

# ─── Security (local dev only — all secrets are public test values) ───────────
# FEE config for sweeper contract deploy
FEE_RECIPIENT=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
FEE_BPS=30
ADMIN_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
