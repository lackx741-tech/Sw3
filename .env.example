# =============================================================================
# .env.example — Sw3 Monorepo Environment Variables
#
# Copy this file to .env (and .env.local for local overrides) and fill in
# the real values. NEVER commit .env or .env.local to version control.
#
# Variable naming conventions:
#   NEXT_PUBLIC_*   → exposed to the browser in Next.js apps
#   VITE_*          → exposed to the browser in Vite apps
#   All others      → server-side / build-time only
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# GENERAL
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development                  # development | test | production
LOG_LEVEL=info                        # trace | debug | info | warn | error
PORT=3000                             # Default HTTP port for the API server
HOST=0.0.0.0


# ─────────────────────────────────────────────────────────────────────────────
# AUTH SERVICE — SIWE + JWT
# ─────────────────────────────────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_random_secret_32_bytes_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Time (seconds) before a SIWE nonce expires (must be used in one round trip)
NONCE_TTL_SECONDS=300

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_random_secret_32_chars_minimum
NEXTAUTH_URL=http://localhost:3000

# OAuth providers (register at respective developer consoles)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# JWT signing key (RS256 — generate with: openssl genrsa 2048)
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d


# ─────────────────────────────────────────────────────────────────────────────
# DATABASE — PostgreSQL (primary)
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://sw3_user:sw3_pass@localhost:5432/sw3_dev?sslmode=disable
DATABASE_URL_TEST=postgresql://sw3_user:sw3_pass@localhost:5432/sw3_test?sslmode=disable

# Read replica (optional — omit to use primary for reads)
DATABASE_READ_URL=postgresql://sw3_readonly:sw3_pass@localhost:5432/sw3_dev?sslmode=disable

# Connection pool limits
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_TIMEOUT_MS=30000


# ─────────────────────────────────────────────────────────────────────────────
# CACHE — Redis
# ─────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_KEY_PREFIX=sw3:


# ─────────────────────────────────────────────────────────────────────────────
# MESSAGE QUEUE
# ─────────────────────────────────────────────────────────────────────────────

# RabbitMQ / CloudAMQP
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Or use Redis Streams / Bull queues — set the queue backend
QUEUE_BACKEND=redis             # redis | rabbitmq | sqs
QUEUE_CONCURRENCY=10


# ─────────────────────────────────────────────────────────────────────────────
# BLOCKCHAIN / WEB3
# ─────────────────────────────────────────────────────────────────────────────

# Public vars (safe to expose to the browser)
NEXT_PUBLIC_CHAIN_ID=1                            # 1=Mainnet, 11155111=Sepolia, 8453=Base
NEXT_PUBLIC_CHAIN_NAME=Ethereum Mainnet
NEXT_PUBLIC_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
NEXT_PUBLIC_WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Server-side RPC (can include private API keys)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_PRIVATE_API_KEY
RPC_URL_FALLBACK=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
WSS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_PRIVATE_API_KEY

# Alchemy
ALCHEMY_API_KEY=your_alchemy_api_key
ALCHEMY_WEBHOOK_AUTH_TOKEN=your_alchemy_webhook_auth_token

# Infura
INFURA_API_KEY=your_infura_api_key
INFURA_API_SECRET=your_infura_api_secret

# Contract addresses (expose public ones with NEXT_PUBLIC_)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# Relayer / backend signer wallet (NEVER expose private keys to the browser)
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RELAYER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266

# Gas configuration
MAX_FEE_PER_GAS_GWEI=50
MAX_PRIORITY_FEE_PER_GAS_GWEI=2


# ─────────────────────────────────────────────────────────────────────────────
# STORAGE — Object Storage (S3-compatible)
# ─────────────────────────────────────────────────────────────────────────────

STORAGE_PROVIDER=s3             # s3 | r2 | gcs | minio | local
S3_REGION=us-east-1
S3_BUCKET=sw3-assets-dev
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_ENDPOINT=                    # Override for MinIO or R2 (leave blank for AWS)
NEXT_PUBLIC_CDN_URL=https://assets.example.com


# ─────────────────────────────────────────────────────────────────────────────
# EMAIL
# ─────────────────────────────────────────────────────────────────────────────

EMAIL_PROVIDER=resend           # smtp | resend | sendgrid | ses
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false               # true for port 465
SMTP_USER=no-reply@example.com
SMTP_PASS=smtp_password

EMAIL_FROM_ADDRESS=no-reply@sw3.xyz
EMAIL_FROM_NAME=Sw3


# ─────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────────

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# OpenTelemetry (OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=sw3-api
OTEL_SERVICE_VERSION=0.0.0

# Datadog (alternative)
DD_API_KEY=your_datadog_api_key
DD_SERVICE=sw3-api
DD_ENV=development


# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING & SECURITY
# ─────────────────────────────────────────────────────────────────────────────

RATE_LIMIT_WINDOW_MS=60000      # 1 minute
RATE_LIMIT_MAX_REQUESTS=100

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API keys for internal service-to-service auth
INTERNAL_API_KEY=replace_with_random_secret_for_service_to_service_auth

# Encryption key for sensitive fields at rest (AES-256 — 32 bytes base64)
FIELD_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_random_key


# ─────────────────────────────────────────────────────────────────────────────
# INDEXER SERVICE
# ─────────────────────────────────────────────────────────────────────────────

INDEXER_START_BLOCK=0           # Block number to start indexing from (0 = genesis)
INDEXER_BATCH_SIZE=500          # Blocks to fetch per batch
INDEXER_POLL_INTERVAL_MS=5000   # How often to poll for new blocks
INDEXER_DATABASE_URL=postgresql://sw3_user:sw3_pass@localhost:5432/sw3_indexer_dev


# ─────────────────────────────────────────────────────────────────────────────
# WORKER SERVICE
# ─────────────────────────────────────────────────────────────────────────────

WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=1000


# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_ENABLE_DEVTOOLS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_MAINTENANCE_MODE=false
ENABLE_SWAGGER_UI=true          # Expose /api/docs in development


# ─────────────────────────────────────────────────────────────────────────────
# CI / CD
# ─────────────────────────────────────────────────────────────────────────────

# Turbo Remote Cache (Vercel — optional, speeds up CI)
TURBO_TOKEN=your_turbo_token
TURBO_TEAM=your_turbo_team_slug

# Docker registry
DOCKER_REGISTRY=ghcr.io/your-org
